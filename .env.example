# ============================================================================
# Root .env  —  docker-compose.yml deploy settings (copy to `.env`, gitignored)
#
# docker compose reads this file for ${VAR} interpolation, and the backend
# container also receives it via env_file, so MEDIA_LIBRARY_* settings placed
# here reach the backend directly. Next.js also loads `.env` in `npm run dev`.
#
# Placeholders only. Never commit real values. Check with: docker compose config
# Hosts / paths reference: docs/architecture/STORAGE_AND_HOSTS.md
# ============================================================================

# ── Host identity (log labels) ──────────────────────────────────────────────
HOST_ID=beelink

# ── Postgres (required) ─────────────────────────────────────────────────────
POSTGRES_USER=media_user
POSTGRES_DB=media_manager
# URL-safe characters only (it is embedded in DATABASE_URL): e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
# Host port for Postgres, bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432

# ── Published ports ─────────────────────────────────────────────────────────
BACKEND_PORT=8082
FRONTEND_PORT=3010

# ── Media mount ─────────────────────────────────────────────────────────────
# Host path of the NAS media share; always mounted at /ark/media in the container.
MEDIA_ROOT=/ark/media
MEDIA_LIBRARY_NAS_MOUNT_CHECK_PATH=/ark/media
JELLYFIN_DEST_BASE=/ark/media/jellyfin
MEDIA_LIBRARY_INGRESS_DEFAULT_PATHS=["/ark/media/ingest"]
MEDIA_LIBRARY_INGRESS_AUTO_START_WATCHER=true

# ── Services on other hosts (required) ──────────────────────────────────────
# disc-ripper-service (needs the optical drive). Used by the backend (mobile rip
# status) and by the frontend's /api/disc-ripper proxy.
DISC_RIPPER_URL=http://ripper-host.lan:8083
# LocalAI (OpenAI-compatible) for the mobile "Scan cover" step.
LOCALAI_URL=http://localai-host.lan:8080

# ── Backend secrets / API keys (optional, but features degrade without them) ─
MEDIA_LIBRARY_OMDB_API_KEY=
MEDIA_LIBRARY_TMDB_API_KEY=
MEDIA_LIBRARY_LOCALAI_API_KEY=
# One-time login passphrase seed, used only when the DB has no password hash yet.
APP_DEFAULT_PASSWORD=

# ── Frontend build-time keys (baked into the browser bundle) ────────────────
NEXT_PUBLIC_OMDB_API_KEY=
NEXT_PUBLIC_TMDB_API_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
# Set false to skip `alembic upgrade head` in the backend entrypoint.
MIGRATE_ON_START=true
# Backend log level (default INFO).
# LOG_LEVEL=INFO
