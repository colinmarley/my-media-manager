# ============================================================================
# Root .env  —  docker-compose.yml settings (copy to `.env`, gitignored)
#
#   cp .env.example .env && $EDITOR .env
#   docker compose config >/dev/null    # names any missing required variable
#
# docker compose reads this file for ${VAR} interpolation, and the backend
# container also receives it via env_file, so MEDIA_LIBRARY_* settings placed
# here reach the backend directly. Next.js also loads `.env` in `npm run dev`.
#
# Placeholders only. Never commit real values.
# Media layout and path rules: docs/architecture/STORAGE_AND_HOSTS.md
# ============================================================================

# ── Host identity (log label only) ──────────────────────────────────────────
HOST_ID=media-host

# ── Postgres (required) ─────────────────────────────────────────────────────
POSTGRES_USER=media_user
POSTGRES_DB=media_manager
# URL-safe characters only (it is embedded in DATABASE_URL): e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
# Host port for Postgres, bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432

# ── Published ports ─────────────────────────────────────────────────────────
BACKEND_PORT=8082
FRONTEND_PORT=3010

# ── Media ───────────────────────────────────────────────────────────────────
# Host directory holding your media (a NAS mount or a local folder). It must
# exist before `docker compose up`. Inside the container it is always mounted
# at /ark/media, the prefix stored in the database, so the container paths
# below stay as they are whatever MEDIA_ROOT is.
#   mkdir -p media/ingest media/jellyfin   # for the default below
MEDIA_ROOT=./media
# Library root (Movies/, TV Shows/, Documentaries/, Live Performances/).
JELLYFIN_DEST_BASE=/ark/media/jellyfin
# Folder(s) the ingest watcher picks new files up from (JSON list).
MEDIA_LIBRARY_INGRESS_DEFAULT_PATHS=["/ark/media/ingest"]
MEDIA_LIBRARY_INGRESS_AUTO_START_WATCHER=true
# Mount guard: the library inventory scan only runs while this path is a mount
# point (the bind mount counts), so an unmounted share is never read as empty.
MEDIA_LIBRARY_NAS_MOUNT_CHECK_PATH=/ark/media
# Optional NAS hostname/IP; when set, the ingress health check probes SMB (445).
MEDIA_LIBRARY_NAS_HOST=

# ── Companion services (required by compose; placeholders are fine) ─────────
# disc-ripper-service (https://github.com/colinmarley/disc-ripper-service).
# Used by the backend (mobile rip status) and the frontend's /api/disc-ripper
# proxy. Without a running ripper those screens just report it unreachable.
DISC_RIPPER_URL=http://ripper-host.lan:8083
# LocalAI (OpenAI-compatible) for the mobile "Scan cover" step.
LOCALAI_URL=http://localai-host.lan:8080

# ── Metadata API keys (optional, but matching degrades without them) ────────
# OMDb: https://www.omdbapi.com/apikey.aspx   TMDB: https://www.themoviedb.org/settings/api
MEDIA_LIBRARY_OMDB_API_KEY=
MEDIA_LIBRARY_TMDB_API_KEY=
MEDIA_LIBRARY_LOCALAI_API_KEY=

# ── Login ───────────────────────────────────────────────────────────────────
# The app has a single shared passphrase. This seeds it on first start, only
# while the database has no passphrase hash yet; change it later in Settings.
# Set this before the first start, or run backend/scripts/seed_password.py later.
APP_DEFAULT_PASSWORD=

# ── Frontend build-time keys (baked into the browser bundle) ────────────────
NEXT_PUBLIC_OMDB_API_KEY=
NEXT_PUBLIC_TMDB_API_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
# Set false to skip `alembic upgrade head` in the backend entrypoint.
MIGRATE_ON_START=true
# Backend log level (default INFO).
# LOG_LEVEL=INFO
