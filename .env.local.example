# ============================================================================
# LOCAL OVERRIDE (.env.local.example) - Development/Local Overrides
# Copy to .env.local and update with your local values
# These override .env.example values and should NOT be committed
# ============================================================================

# Frontend overrides (if using local backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8082

# Backend Firebase credentials (path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
MEDIA_LIBRARY_FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json

# Backend API Keys (optional - for additional matching sources)
MEDIA_LIBRARY_OMDB_API_KEY=your_omdb_api_key
MEDIA_LIBRARY_TMDB_API_KEY=your_tmdb_api_key

# Backend Paths
MEDIA_LIBRARY_INGRESS_DEFAULT_PATHS=["/path/to/encoded/files"]
JELLYFIN_DEST_BASE=/path/to/jellyfin/library

# Backend Automation Settings
MEDIA_LIBRARY_INGRESS_AUTO_START_WATCHER=false
MEDIA_LIBRARY_INGRESS_AUTO_PROCESS_ENABLED=true
MEDIA_LIBRARY_INGRESS_AUTO_ASSIGN_THRESHOLD=80
MEDIA_LIBRARY_INGRESS_AUTO_ORGANIZE_ENABLED=true
