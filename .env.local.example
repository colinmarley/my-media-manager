# ============================================================================
# .env.local  —  local `npm run dev` overrides (copy to `.env.local`, gitignored)
#
# Next.js loads .env.local on top of .env. The Docker deploy does not use this
# file (the build context excludes .env*; see .env.example for deploy settings).
# ============================================================================

# Next.js server-side proxies (/api/backend, /api/disc-ripper)
BACKEND_URL=http://127.0.0.1:8082
DISC_RIPPER_URL=http://localhost:8083

# Browser-side metadata lookups (baked into the client bundle)
NEXT_PUBLIC_OMDB_API_KEY=your_omdb_api_key
NEXT_PUBLIC_OMDB_BASE_URL=https://www.omdbapi.com/
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3/
