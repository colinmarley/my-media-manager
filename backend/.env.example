# ============================================================================
# backend/.env  —  backend settings for running uvicorn outside Docker
# (copy to backend/.env, gitignored). pydantic-settings reads it from the
# working directory; real environment variables win over it.
#
# In the Docker deploy the root .env is the source of truth (docker-compose.yml
# passes it via env_file); backend/.env is optional there and only overrides.
# Placeholders only — never commit real values.
# ============================================================================

# Database (asyncpg URL; alembic/env.py derives the psycopg2 URL from it)
DATABASE_URL=postgresql+asyncpg://media_user:change-me@127.0.0.1:5432/media_manager

# API Keys for External Services
MEDIA_LIBRARY_OMDB_API_KEY=your_omdb_api_key_here
MEDIA_LIBRARY_TMDB_API_KEY=your_tmdb_api_key_here

# Other services (disc-ripper-service and LocalAI run on another host)
MEDIA_LIBRARY_DISC_RIPPER_URL=http://localhost:8083
MEDIA_LIBRARY_LOCALAI_URL=http://localhost:8080
MEDIA_LIBRARY_LOCALAI_API_KEY=

# File Paths (container paths; the NAS share is mounted at /ark/media)
# Ingress: the single ingest root disc-ripper delivers into (sibling of the library)
MEDIA_LIBRARY_INGRESS_DEFAULT_PATHS=["/ark/media/ingest"]
# Destination: the Jellyfin library root (Movies, TV Shows, ...)
JELLYFIN_DEST_BASE=/ark/media/jellyfin
# Mount guard: the NAS share must be mounted here (NAS health / inventory scan)
MEDIA_LIBRARY_NAS_MOUNT_CHECK_PATH=/ark/media

# Watcher Settings
# Set to true to automatically start watching ingress paths on startup.
MEDIA_LIBRARY_INGRESS_AUTO_START_WATCHER=false
MEDIA_LIBRARY_INGRESS_AUTO_PROCESS_ENABLED=true
MEDIA_LIBRARY_INGRESS_AUTO_PROCESS_INTERVAL_SECONDS=2
MEDIA_LIBRARY_INGRESS_AUTO_ASSIGN_THRESHOLD=80
MEDIA_LIBRARY_INGRESS_AUTO_ORGANIZE_ENABLED=true

# Server Settings
MEDIA_LIBRARY_HOST=localhost
MEDIA_LIBRARY_PORT=8082
MEDIA_LIBRARY_RELOAD=false

# Auth / Login
# Optional one-time seed password on first startup if DB has no password_hash yet.
APP_DEFAULT_PASSWORD=
# Keep false to preserve DB password across restarts. Set true only when intentionally resetting from env.
APP_DEFAULT_PASSWORD_FORCE_RESET=false
# Read by settings but not used by any code path today (sessions are DB-stored tokens).
SESSION_SECRET_KEY=

# Logging labels
HOST_ID=dev
LOG_LEVEL=INFO
