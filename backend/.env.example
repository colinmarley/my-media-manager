# ============================================================================
# backend/.env  —  backend settings for running uvicorn outside Docker
# (copy to backend/.env, gitignored). pydantic-settings reads it from the
# working directory; real environment variables win over it.
#
# In the Docker deploy the root .env is the source of truth (docker-compose.yml
# passes it via env_file); backend/.env is optional there and only overrides.
# Every setting in backend/config/settings.py can be set as MEDIA_LIBRARY_<NAME>.
# Placeholders only — never commit real values.
# ============================================================================

# ── Database (asyncpg URL; alembic/env.py derives the psycopg2 URL from it) ──
# Matches `make dev-db` (docker compose up postgres) with the root .env values.
DATABASE_URL=postgresql+asyncpg://media_user:change-me@127.0.0.1:5432/media_manager

# ── Metadata API keys (optional; matching degrades without them) ────────────
MEDIA_LIBRARY_OMDB_API_KEY=
MEDIA_LIBRARY_TMDB_API_KEY=

# ── Companion services (optional) ───────────────────────────────────────────
# disc-ripper-service, for the mobile app's rip status view.
MEDIA_LIBRARY_DISC_RIPPER_URL=http://localhost:8083
# LocalAI (OpenAI-compatible) for the mobile "Scan cover" step.
MEDIA_LIBRARY_LOCALAI_URL=http://localhost:8080
MEDIA_LIBRARY_LOCALAI_API_KEY=
# MEDIA_LIBRARY_LOCALAI_VISION_MODEL=qwen2.5vl-7b

# ── Media paths ─────────────────────────────────────────────────────────────
# In Docker these are container paths under /ark/media. Outside Docker point
# them at real folders on this machine (e.g. D:/media/... or ~/media/...).
# Ingress: the ingest root the watcher reads (disc-ripper-service delivers here).
MEDIA_LIBRARY_INGRESS_DEFAULT_PATHS=["/ark/media/ingest"]
# Destination: the library root (Movies, TV Shows, Documentaries, Live Performances).
JELLYFIN_DEST_BASE=/ark/media/jellyfin
# Mount guard for the inventory scan; empty disables the guard.
MEDIA_LIBRARY_NAS_MOUNT_CHECK_PATH=/ark/media
# Optional NAS host; when set, the ingress health check probes SMB (TCP 445).
MEDIA_LIBRARY_NAS_HOST=
# Other roots (defaults shown).
# HOME_VIDEOS_PATH=/ark/media/home-videos
# TAPE_ARCHIVE_PATH=/ark/media/tape-archive
# MEDIA_ARCHIVE_PATH=/ark/media/catalog-images
# TAPE_INGEST_INGRESS_FOLDER=
# MEDIA_LIBRARY_POSTER_CACHE_DIR=/data/media_manager/posters

# ── Watcher ─────────────────────────────────────────────────────────────────
# Set to true to automatically start watching ingress paths on startup.
MEDIA_LIBRARY_INGRESS_AUTO_START_WATCHER=false
MEDIA_LIBRARY_INGRESS_AUTO_PROCESS_ENABLED=true
MEDIA_LIBRARY_INGRESS_AUTO_PROCESS_INTERVAL_SECONDS=2
MEDIA_LIBRARY_INGRESS_AUTO_ASSIGN_THRESHOLD=80
MEDIA_LIBRARY_INGRESS_AUTO_ORGANIZE_ENABLED=true

# ── Server ──────────────────────────────────────────────────────────────────
MEDIA_LIBRARY_HOST=localhost
MEDIA_LIBRARY_PORT=8082
MEDIA_LIBRARY_RELOAD=false

# ── Auth / login ────────────────────────────────────────────────────────────
# One shared passphrase, no user accounts. Seeded on first startup only while
# the DB has no passphrase hash yet (or run scripts/seed_password.py).
APP_DEFAULT_PASSWORD=
# Keep false to preserve the DB passphrase across restarts; true resets it from env.
APP_DEFAULT_PASSWORD_FORCE_RESET=false
# Read by settings but not used by any code path today (sessions are DB-stored tokens).
SESSION_SECRET_KEY=

# ── Logging labels ──────────────────────────────────────────────────────────
HOST_ID=dev
LOG_LEVEL=INFO
