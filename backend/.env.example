# ============================================================================
# BACKEND (.env.example) - FastAPI Backend Configuration
# Copy to backend/.env and fill in your values
# ============================================================================

# API Keys for External Services
MEDIA_LIBRARY_OMDB_API_KEY=your_omdb_api_key_here
MEDIA_LIBRARY_TMDB_API_KEY=your_tmdb_api_key_here

# AI decision model (TypeSafe Jev or a Jev-compatible server) that labels ingest
# files as main feature / alternate version / special feature.
# off = disabled, shadow = record answers only, assist = act on confident answers
MEDIA_LIBRARY_INGEST_AI_MODE=off
MEDIA_LIBRARY_INGEST_AI_API_KEY=your_typesafe_api_key_here
# MEDIA_LIBRARY_INGEST_AI_BASE_URL=https://api.typesafe.ai/v1
# MEDIA_LIBRARY_INGEST_AI_MODEL=jev-latest
# MEDIA_LIBRARY_INGEST_AI_MIN_CONFIDENCE=0.7

# File Paths
# Ingress paths: where encoded media files are monitored (disc-ripper delivers here)
MEDIA_LIBRARY_INGRESS_DEFAULT_PATHS=["/ark/media/jellyfin/ingest"]

# Destination: where files are organized (Jellyfin-compatible structure)
JELLYFIN_DEST_BASE=/ark/media/jellyfin

# Watcher Settings
# Set to true to automatically start watching ingress paths on startup.
# When true, files delivered by disc-ripper are picked up automatically.
MEDIA_LIBRARY_INGRESS_AUTO_START_WATCHER=true
MEDIA_LIBRARY_INGRESS_AUTO_PROCESS_ENABLED=true
MEDIA_LIBRARY_INGRESS_AUTO_PROCESS_INTERVAL_SECONDS=2
MEDIA_LIBRARY_INGRESS_AUTO_ASSIGN_THRESHOLD=80
MEDIA_LIBRARY_INGRESS_AUTO_ORGANIZE_ENABLED=true

# Firebase Configuration
MEDIA_LIBRARY_FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
MEDIA_LIBRARY_FIREBASE_PROJECT_ID=media-db-cc511

# Server Settings
MEDIA_LIBRARY_HOST=localhost
MEDIA_LIBRARY_PORT=8082
MEDIA_LIBRARY_RELOAD=false

# Auth / Login
# Optional one-time seed password on first startup if DB has no password_hash yet.
APP_DEFAULT_PASSWORD=
# Keep false to preserve DB password across restarts. Set true only when intentionally resetting from env.
APP_DEFAULT_PASSWORD_FORCE_RESET=false
SESSION_SECRET_KEY=
