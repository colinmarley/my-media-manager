# Host folder holding models/OneJev1.5-9B.Q8_0.gguf and tokenizer/OneJev1.5-9B/ (see docs/guides/LOCAL_DECIDER.md).
DECIDER_DATA=/data/mmm-decider
DECIDER_PORT=8130
# llama.cpp threads and the container's CPU cap. One disc folder takes ~15 s at p50 with 12 threads.
DECIDER_THREADS=12
DECIDER_CPUS=12
